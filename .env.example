# Copy to .env (gitignored) and fill in. Values here are placeholders only.
ISSUER=http://localhost:3410
AS_URL=http://localhost:3410
CLOUD_URL=http://localhost:3411
# Generate with: openssl rand -hex 32
AS_ADMIN_TOKEN=replace-me
CLOUD_SERVICE_TOKEN=replace-me
# Optional: service-account token for op:// references. Falls back to ~/.config/op/sa-token.
OP_SERVICE_ACCOUNT_TOKEN=
# Optional: an op:// reference used by the op source test. Non-sensitive URL-valued field.
OP_TEST_REF=
